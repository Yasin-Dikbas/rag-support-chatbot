# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini API key, free tier, no credit card required (https://aistudio.google.com/apikey)
# Used both for chat generation (gemini-2.5-flash) and embeddings (gemini-embedding-001).
GEMINI_API_KEY=

# Random secret used to sign JWT auth tokens issued to the React frontend.
# Generate one with: ruby -rsecurerandom -e "puts SecureRandom.hex(64)"
JWT_SECRET=

# React dashboard dev server origin, used for CORS on the authenticated API.
# The public /api/widget/* endpoints allow any origin regardless of this value.
FRONTEND_URL=http://localhost:5175
